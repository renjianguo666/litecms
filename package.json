{
    "name": "litecms",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "type": "commonjs",
    "scripts": {
        "dev:css": "tailwindcss -i ./resources/app.css -o ./public/static/css/app.css --watch",
        "build:css": "tailwindcss -i ./resources/app.css -o ./public/static/css/app.css --minify",
        "dev:web:css": "tailwindcss -i ./resources/web.css -o ./public/static/css/web.css --watch",
        "build:web:css": "tailwindcss -i ./resources/web.css -o ./public/static/css/web.css --minify",
        "dev:js": "esbuild resources/app.js --bundle --outfile=public/static/js/app.bundle.js --format=esm --sourcemap --watch",
        "build:js": "esbuild resources/app.js --bundle --outfile=public/static/js/app.bundle.js --format=esm --minify",
        "dev:editor:js": "esbuild resources/editor.js --bundle --outfile=public/static/js/editor.bundle.js --format=esm --sourcemap --watch",
        "dev:editor:css": "tailwindcss -i ./resources/editor/editor.css -o ./public/static/css/editor.css --watch",
        "dev:editor": "concurrently \"npm run dev:editor:js\" \"npm run dev:editor:css\"",
        "build:editor:js": "esbuild resources/editor.js --bundle --outfile=public/static/js/editor.bundle.js --format=esm --minify",
        "build:editor:css": "tailwindcss -i ./resources/editor/editor.css -o ./public/static/css/editor.css --minify",
        "build:editor": "npm run build:editor:js && npm run build:editor:css",
        "dev": "concurrently \"npm run dev:css\" \"npm run dev:web:css\" \"npm run dev:js\" \"npm run dev:editor:js\" \"npm run dev:editor:css\"",
        "build": "npm run build:css && npm run build:web:css && npm run build:js && npm run build:editor"
    },
    "dependencies": {
        "@tiptap/core": "^3.27.1",
        "@tiptap/extension-character-count": "^3.27.1",
        "@tiptap/extension-image": "^3.27.1",
        "@tiptap/extension-placeholder": "^3.27.1",
        "@tiptap/extension-text-align": "^3.27.1",
        "@tiptap/extensions": "^3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "alpinejs": "^3.15.12",
        "vanilla-calendar-pro": "^3.1.0"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.115",
        "@iconify/tailwind4": "^1.2.3",
        "@tailwindcss/cli": "^4.3.2",
        "concurrently": "^10.0.3",
        "daisyui": "^5.6.6",
        "esbuild": "^0.28.1",
        "rolldown": "^1.1.4",
        "tailwindcss": "^4.3.2"
    }
}
