{% extends "base.html.j2" %}

{% block workspace %}
  {% macro render_category_tree_table(nodes, level=0) %}
    {% for row in nodes %}
      <tr class="hover:bg-base-300">
        <td style="padding-left: {{ level * 1.5 + 1.5 }}rem">
          <div class="flex items-center gap-2">
            {% if row.children %}
              <span class="icon-[lucide--folder] text-lg shrink-0 text-muted-foreground"></span>
            {% endif %}
            <span class="text-sm text-foreground">{{ row.name }}</span>
          </div>
        </td>
        <td>{{ row.priority }}</td>
        <td>{{ row.page_size }}</td>
        <td>{{ row.created_at }}</td>
        <td class="py-0">
          <div class="flex items-center justify-end gap-1.5">
            <a
              href="{{ row.absolute_url }}"
              target="_blank"
              class="btn btn-sm btn-dash btn-info"
            >
              查看
            </a>
            {% if request.user.has_permission("categories:update") %}
              <a
                href="{{ url_for('categories:edit', item_id=row.id) }}"
                hx-vals="js:{url: location.pathname + location.search}"
                class="btn btn-sm btn-dash btn-info"
              >
                编辑
              </a>
            {% endif %}
            {% if request.user.has_permission("categories:destroy") %}
              <button
                type="button"
                hx-get="{{ url_for('categories:destroy_form', item_id=row.id) }}?dialog=true"
                hx-target="#dialog-container"
                hx-select="dialog"
                class="btn btn-sm btn-dash btn-warning"
              >
                删除
              </button>
            {% endif %}
          </div>
        </td>
      </tr>
      {% if row.children %}
        {{ render_category_tree_table(row.children, level + 1) }}
      {% endif %}
    {% endfor %}
  {% endmacro %}

  <div class="flex flex-col gap-3">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <h2 class="text-xl font-semibold ps-2">栏目管理</h2>

      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <form
          class="relative w-full sm:w-64"
          action="{{ url_for('categories:index') }}"
          hx-trigger="keyup changed delay:500ms from:#search-input, search from:#search-input"
        >
          <input
            type="search"
            id="search-input"
            name="search"
            value="{{ request.query_params.get('search', '') }}"
            placeholder="搜索..."
            class="input"
          >
        </form>

        {% if request.user.has_permission("categories:create") %}
          <a
            href="{{ url_for('categories:new') }}"
            hx-vals="js:{url: location.pathname + location.search}"
            class="btn btn-neutral"
          >
            <span class="icon-[lucide--plus] text-lg"></span>
            新增栏目
          </a>
        {% endif %}
      </div>
    </div>

    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 shadow-sm">
      <table class="table">
        <thead>
          <tr>
            <th>
              栏目名
            </th>
            <th>
              优先级
            </th>
            <th>
              页面大小
            </th>
            <th>
              创建时间
            </th>
            <th class="text-right">
              操作
            </th>
          </tr>
        </thead>
        <tbody>
          {{ render_category_tree_table(categories) }}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
