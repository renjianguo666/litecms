{% extends "base.html.j2" %}

{% block workspace %}
  {% from 'macros/base/pagination.html.j2' import render_pagination with context %}

  <div class="flex flex-col gap-3">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <h2 class="text-xl font-semibold ps-2">
        推荐管理
        <span class="ml-2 text-sm font-normal text-base-content/50">
          / 内容
        </span>
      </h2>

      <a class="btn" href="{{ url_for('features:index') }}">
        <span class="icon-[lucide--arrow-left] text-lg"></span>
        返回列表
      </a>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm rounded-box">
      <div class="card-body p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <h3 class="text-lg font-semibold leading-none">{{ feature.name }}</h3>
            <span id="attached-count" class="text-sm text-base-content/60">
              共
              <span class="font-medium text-base-content">{{ pagination.total }}</span>
              条记录
            </span>
          </div>
          <div class="flex gap-2">
            <button
              class="btn btn-sm"
              hx-get="{{ url_for('features:edit', item_id=feature.id) }}?dialog=true"
              hx-target="#dialog-container"
              hx-select="dialog"
              hx-push-url="false"
            >
              <span class="icon-[lucide--pencil] text-lg"></span>
              编辑推荐
            </button>
            <button
              class="btn btn-neutral btn-sm"
              hx-get="{{ url_for('features:manage_available', item_id=feature.id) }}?dialog=true"
              hx-target="#dialog-container"
              hx-select="dialog"
              hx-push-url="false"
            >
              <span class="icon-[lucide--plus] text-lg"></span>
              添加内容
            </button>
          </div>
        </div>
      </div>
    </div>

    <form
      hx-post="{{ url_for('features:detach_contents', item_id=feature.id) }}"
      hx-vals="js:{url: location.pathname + location.search}"
      hx-push-url="false"
      hx-confirm="确定移除选中的文章吗？"
    >
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 shadow-sm">
        <table class="table">
          <thead>
            <tr>
              {% if pagination.total > 0 %}
                <th class="w-8">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-sm"
                    onclick="this.closest('table').querySelectorAll('input[name=content_ids]').forEach(cb => cb.checked = this.checked)"
                  >
                </th>
              {% endif %}
              <th>标题</th>
              <th>栏目</th>
              <th>创建时间</th>
            </tr>
          </thead>
          <tbody>
            {% for row in pagination.items %}
              <tr class="hover:bg-base-300">
                <td>
                  <input type="checkbox" name="content_ids" value="{{ row.id }}" class="checkbox checkbox-sm">
                </td>
                <td class="font-medium">{{ row.title }}</td>
                <td class="text-base-content/60">{{ row.category.name }}</td>
                <td class="text-base-content/60">
                  {{ row.created_at.strftime('%Y-%m-%d %H:%M') if row.created_at else '-' }}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4" class="text-center py-12 text-base-content/50">
                  暂无关联内容
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pagination.total > 0 %}
        <div class="flex items-center justify-between mt-3">
          <button type="submit" class="btn btn-sm btn-soft">
            <span class="icon-[lucide--trash-2] text-lg"></span>
            移除选中
          </button>
          {{ render_pagination(pagination) }}
        </div>
      {% endif %}
    </form>
  </div>
{% endblock %}
