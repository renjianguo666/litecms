{% extends "base.html.j2" %}

{% block workspace %}
  {% from 'macros/form.html.j2' import render_form_page with context %}
  {% from 'macros/base/form.html.j2' import render_field with context %}

  {% call render_form_page(form, "pages", "单页") %}
    <form
      class="grid grid-cols-1 lg:grid-cols-12 gap-6"
      action="{{ url_for('pages:create') if not request.path_params.item_id else url_for('pages:update', item_id=request.path_params.item_id) }}"
      method="post"
      hx-disabled-elt="[type=submit]"
    >
      <input type="hidden" name="url" value="{{ request.query_params.url or url_for('pages:index') | e }}">
      <div class="lg:col-span-8 flex flex-col gap-6">
        <div class="card bg-base-100 shadow-sm border border-base-300">
          <div class="card-body p-6 flex flex-col gap-4">
            {{ render_field(form.title) }}

            {# 内容编辑器 #}
            <div class="flex flex-col gap-1.5">
              <textarea
                name="text"
                class="hidden"
                data-editor
                data-config='{{ {"uploadUrl": url_for("media:upload"), "placeholder": "请输入内容...", "height": "300px"} | tojson }}'
              >{{ form.text.data or '' }}</textarea>
              {% for error in form.text.errors %}
                <p class="text-xs text-error">{{ error }}</p>
              {% endfor %}
            </div>

            {{ render_field(form.description) }}
            {{ render_field(form.cover_url) }}
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="card bg-base-100 shadow-sm border border-base-300">
          <div class="card-body p-6 flex flex-col gap-5">
            {{ render_field(form.path) }}
            {{ render_field(form.template) }}
            {{ render_field(form.is_active) }}
            {{ form.submit(class="btn btn-neutral") }}
          </div>
        </div>
      </div>
    </form>
  {% endcall %}

  <script type="module" src="{{ url_for('static', file_path='js/editor.bundle.js') }}"></script>
{% endblock %}
