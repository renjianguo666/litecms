<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ settings.site_name }}_LiteCMS</title>
    <link href="{{ url_for('static', file_path='css/app.css') }}" rel="stylesheet" type="text/css">
    <link href="{{ url_for('static', file_path='css/editor.css') }}" rel="stylesheet" type="text/css">
    <script src="{{ url_for('static', file_path='js/htmx.min.js') }}"></script>
    <script type="module" src="{{ url_for('static', file_path='js/app.bundle.js') }}"></script>
  </head>
  <body
    hx-boost="true"
    hx-target="#workspace"
    hx-swap="innerHTML"
    @resize.window="handleResize"
    x-data="sidebarState"
    :class="bodyClasses"
    class="bg-base-200 text-base-content antialiased sidebar-expand-lg h-screen overflow-hidden"
  >
    <div
      @click="sidebarOpen = false"
      class="fixed inset-0 bg-neutral/60 z-40 lg:hidden"
      :class="{ 'hidden': isDesktop || !sidebarOpen }"
    >
    </div>

    <aside class="app-sidebar bg-base-100 border-r border-base-300 flex flex-col">
      <div class="h-14 flex items-center border-b border-base-300 shrink-0 px-4">
        <a
          href="/admin"
          class="flex items-center justify-center gap-3 text-lg font-light tracking-wide w-full overflow-hidden whitespace-nowrap"
        >
          <span class="font-semibold">LiteCMS</span>
        </a>
      </div>

      <nav class="flex-1 overflow-y-auto sidebar-scroll p-3">
        {% include 'base_menu.html.j2' %}
      </nav>
    </aside>

    <div class="app-wrapper flex-1 relative min-w-0">
      {% include 'base_header.html.j2' %}
      <main
        class="flex-1 min-h-0 px-6 py-4 overflow-y-auto sidebar-scroll bg-texture-mesh"
        id="workspace"
      >
        {% block workspace %}{% endblock %}
      </main>
    </div>

    <div id="dialog-container"></div>

    <div
      x-data="toastManager"
      x-init="document.body.addEventListener('showToast', (e) => add(e.detail));"
      class="toast toast-end toast-bottom z-9999"
    >
      <template x-for="toast in toasts" :key="toast.id">
        <div
          role="alert"
          class="alert shadow-lg w-80"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-4"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-2"
          :class="alertClass(toast.type)"
        >
          <span x-show="toast.type === 'success'" class="icon-[lucide--circle-check] text-xl shrink-0"></span>
          <span
            x-show="toast.type === 'error' || toast.type === 'danger'"
            class="icon-[lucide--circle-x] text-xl shrink-0"
          ></span>
          <span x-show="toast.type === 'info'" class="icon-[lucide--info] text-xl shrink-0"></span>
          <span x-text="toast.message"></span>
          <button @click="remove(toast.id)" class="btn btn-ghost btn-xs btn-circle ml-2">
            ✕
          </button>
        </div>
      </template>
    </div>
  </body>
</html>
