{%- from "macros/base/form.html.j2" import render_field with context -%}

{%- macro render_dialog(title,extra_class="") -%}
  <dialog
    x-data
    x-init="$el.showModal()"
    @close="$el.remove()"
    class="modal"
  >
    <div class="modal-box flex flex-col p-0 {{ extra_class }}">
      <div class="flex items-center justify-between px-6 py-4 border-b border-base-300 shrink-0">
        <h3 class="text-lg font-bold">{{ title }}</h3>
        <button
          type="button"
          @click="$el.closest('dialog').close()"
          class="btn btn-sm btn-circle btn-ghost"
        >
          <span class="icon-[lucide--x] text-lg"></span>
        </button>
      </div>
      {%- if caller is defined -%}{{ caller() }}{%- endif -%}
    </div>
  </dialog>
{%- endmacro -%}
