<header class="sticky top-0 z-30 bg-base-100 h-14 px-4 flex items-center justify-between border-b border-base-300">
  <div class="flex items-center gap-2">
    <button class="btn btn-square btn-ghost btn-sm" @click="toggle()">
      <span class="icon-[lucide--menu] text-xl"></span>
    </button>
    <button
      type="button"
      class="btn btn-sm"
      hx-get="{{ url_for('seo:push_form') }}?dialog=true"
      hx-target="#dialog-container"
      hx-select="dialog"
      hx-push-url="false"
    >
      <span class="icon-[lucide--file-input] text-lg"></span>
      百度推送
    </button>
  </div>

  <div class="flex items-center gap-1 sm:gap-2">
    <!--<div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm relative text-base-content/70">
        <span class="icon-[lucide--message-circle] text-lg"></span>

        <span class="badge badge-error badge-xs absolute top-0 right-0 text-[10px] text-white border-none shadow-sm"
        >3</span>
      </div>

      <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52 z-50">
        <li class="menu-title">Messages</li>
        <li><a>You have 3 unread messages.</a></li>
      </ul>
    </div>-->

    <!--<div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm relative text-base-content/70">
        <span class="icon-[lucide--bell] text-lg"></span>

        <span class="badge badge-warning badge-xs absolute top-0 right-0 text-[10px] border-none shadow-sm text-black"
        >15</span>
      </div>
      <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52 z-50">
        <li class="menu-title">Notifications</li>
        <li><a>System update available</a></li>
      </ul>
    </div>-->

    <!-- 全屏切换：逻辑已抽到 app.js 的 fullscreenToggle 组件 -->
    <button
      x-data="fullscreenToggle"
      @click="toggle()"
      class="btn btn-ghost btn-circle btn-sm hidden md:inline-flex text-base-content/70"
    >
      <span class="icon-[lucide--maximize] text-lg" :class="{ 'hidden': isFullscreen }"></span>
      <span class="icon-[lucide--minimize] text-lg" :class="{ 'hidden': !isFullscreen }"></span>
    </button>

    <label class="btn btn-ghost btn-circle btn-sm text-base-content/70 flex items-center justify-center p-0">
      <div class="swap swap-rotate w-5 h-5">
        <input type="checkbox" class="theme-controller opacity-0 absolute w-0 h-0" value="dark">

        <span class="icon-[lucide--sun] text-lg swap-off"></span>
        <span class="icon-[lucide--moon] text-lg swap-on"></span>
      </div>
    </label>

    <div class="dropdown dropdown-end ml-1">
      <div
        tabindex="0"
        role="button"
        class="btn btn-ghost rounded-full px-2 flex items-center gap-2 hover:bg-base-200 transition-colors h-10 min-h-10"
      >
        <div class="w-8 h-8 rounded-full bg-neutral text-neutral-content ring-1 ring-base-300 flex items-center justify-center text-xs font-bold">
          {{ request.user.username[0]|upper }}
        </div>
        <span class="text-sm font-medium hidden md:block">{{ request.user.username }}</span>
      </div>
      <ul
        tabindex="0"
        class="mt-3 z-1 p-2 shadow-lg menu menu-sm dropdown-content bg-base-100 rounded-box w-52 border border-base-300"
      >
        <li>
          <a href='{{ url_for("profile:password")}}' class="py-2"><span
              class="icon-[lucide--user] text-lg mr-2 opacity-70"
            ></span>修改密码</a>
        </li>
        <li tabindex="-1" class="p-0"></li>
        <li>
          <!-- POST 注销(hx-post): 防止 <img src=/admin/logout> 等 CSRF 强制登出, HTMX 自动携带 csrf token -->
          <button
            type="button"
            hx-post="{{ url_for('auth:logout') }}"
            hx-confirm="确定要退出登录吗？"
            class="w-full text-left py-2 text-error hover:bg-error/10 hover:text-error"
          >
            <span class="icon-[lucide--log-out] text-lg mr-2"></span>退出注销
          </button>
        </li>
      </ul>
    </div>
  </div>
</header>
