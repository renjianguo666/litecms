# 兼容 windows 默认gbk cp936 导致read_text  UnicodeDecodeError: gbk 问题
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# 正式配置项

DEBUG=True
# SECRET_KEY=niubclass

# session cookie 安全加固(可选): 默认 false, HTTP/HTTPS 都能登录, 无需配置。
# 纯 HTTPS 部署想开启 Secure(仅 HTTPS 携带登录 cookie)时, 删掉下一行的 # 即可:
# SESSION_COOKIE_SECURE=true

# DATABASE_URL=postgresql+psycopg://[user]:[password]@127.0.0.1:5432/[dbname]

# oss配置
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_REGION=cn-beijing
# OSS_BUCKET=testdemolcms
# OSS_CDN_URL=
# 阿里云oss 开启内外互通 减少资费
# OSS_USE_INTERNAL=true


